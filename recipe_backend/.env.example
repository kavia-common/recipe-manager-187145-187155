# Optional environment variables for the Recipe Backend
# Copy to .env and adjust as needed. Do not commit real secrets.

# Server configuration
HOST=0.0.0.0
PORT=3001
FLASK_ENV=development

# Database configuration
# For SQLite file in working dir (default): sqlite:///recipes.db
# For instance folder file: sqlite:///instance/recipes.db
DATABASE_URL=sqlite:///recipes.db

# Flask secret key (use a strong value in production)
SECRET_KEY=dev-secret
